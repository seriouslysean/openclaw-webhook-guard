{
  "name": "@seriouslysean/openclaw-webhook-guard",
  "version": "0.1.0",
  "private": true,
  "description": "An OpenClaw plugin that blocks agents' scheduled jobs from posting to a URL.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "agents",
    "cron",
    "webhook"
  ],
  "homepage": "https://github.com/seriouslysean/openclaw-webhook-guard#readme",
  "bugs": "https://github.com/seriouslysean/openclaw-webhook-guard/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seriouslysean/openclaw-webhook-guard.git"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 'test/*.test.ts'"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.4"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "openclaw": "2026.10.4",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "compat": {
      "pluginApi": ">=2026.10.4",
      "minGatewayVersion": "2026.10.4"
    },
    "build": {
      "openclawVersion": "2026.10.4",
      "pluginSdkVersion": "2026.10.4"
    }
  }
}
